# Hostaway API (https://api.hostaway.com)
# Account ID and API Key from Hostaway dashboard: Settings > API
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Only needed if Stripe redirects guests to a broken URL after
# checkout (e.g. http://0.0.0.0:3000/...) — that means this host's reverse
# proxy isn't forwarding the real Host header. Set this to the site's real
# public URL (e.g. https://vip.weblaucher.com) to force it explicitly.
NEXT_PUBLIC_SITE_URL=
